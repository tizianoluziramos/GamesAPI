{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "baseUrl": "./src",
    "rootDir": "src",

    "noEmit": true,
    "incremental": true,
    "pretty": false,

    "types": ["node"]
  }
}
